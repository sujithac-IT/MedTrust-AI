# MediTrust AI — Environment Variables
# Copy this file to .env.local and replace with your credentials
# The application works in full Demo Mode without any credentials configured.

# ── Firebase Configuration ──
# Get from: https://console.firebase.google.com → Project Settings → Your Apps
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ── Google Meet Configuration ──
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Enable: Google Meet API, Google Calendar API
# Create: OAuth 2.0 Client ID (Web application)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your-google-api-key

# ── Gemini AI Configuration ──
# Get from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key
